# Copy to `.env` and adjust as needed. `.env` is gitignored.
# Consumed by `docker/docker-compose.dev.yml` and `scripts/db-query.sh`.

# --- MySQL container ---
MYSQL_CONTAINER_NAME=mysql-dev
MYSQL_SERVICE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_HOST_PORT=3306

# Root account (container-internal use only).
MYSQL_ROOT_PASSWORD=root

# Default database created on first boot.
MYSQL_DATABASE=default

# Default application user (read/write on MYSQL_DATABASE).
MYSQL_DEFAULT_USER=default
MYSQL_DEFAULT_USER_PASSWORD=default

# Read-only user used by `scripts/db-query.sh` and the `mysql-dev` subagent.
MYSQL_CLAUDE_USER=claude
MYSQL_CLAUDE_USER_PASSWORD=claude
